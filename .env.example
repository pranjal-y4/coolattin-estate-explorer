# ── Flask ────────────────────────────────────────────────────────────────────
# Change in production. Any random 32+ char string works.
SECRET_KEY=dev-secret-change-in-prod

# "development" | "production"
FLASK_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use the default SQLite file at project root (coolattin.db).
# For PostgreSQL: postgresql://user:pass@host:5432/dbname
# DATABASE_URL=
# Optional explicit SQLite file path, useful on Azure App Service.
# Example: /home/site/data/coolattin.db
# DATABASE_PATH=
VM_RG="yadavp2"
NSG_NAME="coolattin-graphdbNSG"
MY_IP="185.134.146.69"
APP_IPS="4.232.112.153 4.232.112.154 4.232.112.155 4.232.112.156 4.232.112.157 4.232.112.168 4.232.112.84 4.232.112.203 4.232.112.150 4.232.112.151 4.232.112.222 4.232.113.44 4.232.99.2"


# Local GraphDB default for development.
GRAPHDB_SPARQL_ENDPOINT=http://127.0.0.1:7200/repositories/coolattin
GRAPHDB_ENABLED=true
GRAPHDB_REQUEST_TIMEOUT=15


# ── LLM provider (Ask page) ──────────────────────────────────────────────────
# "auto" tries OpenRouter first, falls back to Ollama, then disables LLM.
# Other values: "openrouter" | "ollama" | "none"
ASK_LLM_PROVIDER=auto
# Set to false only if you need to force the legacy Ask pipeline.
ASK_USE_NEW_PIPELINE=true

# Set to false to restrict the Ask pipeline to free/local models only
# (skips Anthropic and Grok API calls; falls back to OpenRouter/Ollama).
LLM_ALLOW_PAID=true

# Which model handles final answer synthesis: "claude" | "grok" | "openrouter" | "ollama"
ASK_SYNTHESIS_MODEL=claude

# ── Ask-page dense retrieval (optional pgvector) ─────────────────────────────
# Only used by the Ask-page natural-language pipeline when DATABASE_URL points
# to PostgreSQL and pgvector is available there.
# Example: postgresql://user:pass@host:5432/coolattin
# DATABASE_URL=
# Cohere Embed v3 — replaces Voyage AI as the embedding provider.
# Model embed-english-v3.0 is 1024-dim (same as voyage-3; no schema change).
# Trial key: 1,000 calls/month, 5 calls/min on Embed endpoint.
COHERE_API_KEY=
COHERE_MODEL=embed-english-v3.0
# Legacy aliases kept for backward-compat with any env that still sets these.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
VOYAGE_OUTPUT_DIMENSION=1024

# ── OpenRouter (cloud LLM) ───────────────────────────────────────────────────
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=http://127.0.0.1:5001
OPENROUTER_APP_TITLE=Coolattin Archive Ask

# Timeouts (seconds)
OPENROUTER_CONNECT_TIMEOUT=10
OPENROUTER_REQUEST_TIMEOUT=80

# Leave at 0 to return a clear "no validated SQL" message instead of guessing
# with a heuristic query when generation or repair fails.
ASK_ALLOW_HEURISTIC_FALLBACK=0

# Set to 1 to use the LLM to generate VRTI SPARQL queries (slower, experimental)
ASK_GENERATE_VRTI_SQL_WITH_LLM=0

# ── Ollama (local fallback LLM) ──────────────────────────────────────────────
# Install Ollama from https://ollama.ai, then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_KEEP_ALIVE=10m

# ── VRTI Knowledge Graph ─────────────────────────────────────────────────────
# Public endpoint — override only if using a mirror or proxy.
# VRTI_SPARQL_ENDPOINT=https://virtuoso.virtualtreasury.ie/sparql/
VRTI_REQUEST_TIMEOUT=30

# ── In-process GraphRAG (property graph — no extra server needed) ─────────────
# Build the graph once after ingest: python3 scripts/build_graph.py
# Then the Ask pipeline enriches answers with k-hop subgraph traversal.
GRAPHRAG_ENABLED=true
GRAPHRAG_VECTOR_TOP_K=8
GRAPHRAG_K_HOPS=2
GRAPHRAG_MAX_NODES=120

# ── GraphDB Azure VM override example ────────────────────────────────────────
# Uncomment and use this instead of localhost only when targeting the remote VM.
# GRAPHDB_SPARQL_ENDPOINT=http://51.120.71.162:7200/repositories/coolattin

# ── Logging ──────────────────────────────────────────────────────────────────
# "DEBUG" | "INFO" | "WARNING" | "ERROR"
LOG_LEVEL=INFO
