# ── Secrets & local config ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
.pytest_cache/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/

# ── Node (front end loads Leaflet/Chart.js/D3 from CDN; no build step) ───────
node_modules/
npm-debug.log*

# ── Database (binary, regenerated via ingest jobs) ───────────────────────────
# coolattin.db is committed so Azure deployment has data without a separate ingest step
*.db-wal
*.db-shm

# ── Generated exports & local backups (runtime output, not source) ───────────
exports/*
!exports/.gitkeep
*.bak
*.zip
data/coolattin_sample.ttl

# ── Large data files (>100 MB, exceed GitHub's file size limit) ──────────────
extra_datasets/NMS_OpenData_20230823.csv
data/entity_index.pkl

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
